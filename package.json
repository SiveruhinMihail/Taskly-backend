{
  "dependencies": {
    "@wesleytodd/openapi": "^1.1.0",
    "axios": "^1.10.0",
    "bcrypt": "^5.1.1",
    "cors": "^2.8.5",
    "dotenv": "^16.5.0",
    "express": "^5.1.0",
    "express-oas-generator": "^1.0.48",
    "jq": "^1.7.2",
    "jsonwebtoken": "^9.0.2",
    "mongod": "^2.0.0",
    "mongoose": "^8.16.0",
    "mongoose-sequence": "^6.0.1",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "eslint": "^9.31.0",
    "eslint-config-prettier": "^10.1.5",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-node": "^11.1.0",
    "eslint-plugin-prettier": "^5.5.0",
    "jest": "^30.0.4",
    "nodemon": "^3.1.10"
  },
  "scripts": {
    "start": "node app.js",
    "dev": "nodemon --verbose --watch . --ext js,json --exec node app.js",
    "test": "jest",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "docker:dev": "docker-compose -f docker-compose.dev.yml up -d",
    "docker:dev:build": "docker-compose -f docker-compose.dev.yml up -d --build",
    "docker:dev:logs": "docker-compose -f docker-compose.dev.yml logs -f",
    "docker:dev:down": "docker-compose -f docker-compose.dev.yml down",
    "docker:dev:clean": "docker-compose -f docker-compose.dev.yml down -v",
    "docker:prod": "docker-compose -f docker-compose.yml up -d",
    "docker:prod:build": "docker-compose -f docker-compose.yml up -d --build",
    "docker:prod:logs": "docker-compose -f docker-compose.yml logs -f",
    "docker:prod:down": "docker-compose -f docker-compose.yml down",
    "docker:prod:clean": "docker-compose -f docker-compose.yml down -v",
    "docker:restart": "npm run docker:down && npm run docker:up",
    "docker:rebuild": "npm run docker:down && npm run docker:up:build"
  }
}
